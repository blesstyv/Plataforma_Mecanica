# Copia a .env (nunca se sube a Git). Ver docs/deployment para producción.
DJANGO_SETTINGS_MODULE=config.settings.local
# Obligatoria en producción (>= 40 caracteres aleatorios):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://mecanica:mecanica@localhost:5432/plataforma_mecanica

# Orígenes del frontend (CORS/CSRF). En producción usa el dominio HTTPS real.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Archivos: disco local privado en desarrollo; S3 obligatorio en producción
USE_S3=False
PRIVATE_MEDIA_ROOT=
MAX_UPLOAD_MB=50
S3_BUCKET_NAME=
S3_ENDPOINT_URL=          # Supabase: https://<PROJECT_REF>.storage.supabase.co/storage/v1/s3
S3_SERVE_MODE=redirect    # "stream" si el proveedor no admite URLs firmadas
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto            # Supabase: la región real del proyecto, p. ej. us-east-1
S3_URL_EXPIRE_SECONDS=300

# Seguridad de login
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# Solo para el comando create_teacher (puedes pasar --password en su lugar)
DJANGO_TEACHER_USERNAME=profesor
DJANGO_TEACHER_EMAIL=
DJANGO_TEACHER_PASSWORD=
